# ------------------------------------------------------------------------------
# YOKUBO GPT — SECURE ENVIRONMENT CONFIGURATION TEMPLATE
# ------------------------------------------------------------------------------
# Copy this file to '.env' or add these variables directly in your Railway dashboard.

# Server Configuration
PORT=3000

# Google Gemini API (Mandatory for core assistant & thinking engine)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# App Public URL (For SEO sitemaps, OpenGraph previews and verification loops)
# On Railway, this will be your service domain: e.g., https://yokubo-gpt.up.railway.app
APP_URL="https://your-domain.up.railway.app"

# Third-Party AI Engine Integrations (Optional fallbacks)
# Mistral AI Large Engine
MISTRAL_API_KEY="your-mistral-api-key-here"

# Anthropic Claude 3.5 Sonnet Engine
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# DeepSeek V3 Engine
DEEPSEEK_API_KEY="your-deepseek-api-key-here"

# Email Verification Engine (Optional)
# Used to send physical verification codes to users. If missing, codes are logged to simulated dev inbox.
# Get a key from: https://resend.com/
RESEND_API_KEY="your-resend-api-key-here"

# Note: Firebase Admin is initialized automatically using Google Application Default Credentials
# or the values in firebase-applet-config.json. On Railway, make sure to add your
# Firebase Project ID to the environment or include firebase-applet-config.json in your deployment.
